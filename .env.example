# Required: Discord bot token and application ID.
TOKEN=replace-with-discord-bot-token
CLIENT_ID=replace-with-discord-application-id

# Public origin used for links to locally stored car images.
# Use your hostname with HTTPS when a reverse proxy terminates TLS.
IMAGE_BASE_URL=https://your-hostname.example.com

# Optional: enables dashboard points-management login when set.
POINTS_ADMIN_PASSWORD=replace-with-a-strong-password
